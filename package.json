{
  "name": "vue-track-plush",
  "version": "3.0.0",
  "description": "基于 vue 自定义指令的埋点统计插件",
  "main": "dist/vue-track-plush.umd.js",
  "module": "dist/vue-track-plush.esm.js",
  "types": "types/vue-track-plush.d.ts",
  "private": false,
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "dev:plugin": "vite build --config vite.plugin.config.ts --watch",
    "build": "pnpm build:plugin",
    "build:plugin": "run-s clean:temp build:plugin:js build:plugin:types clean:temp",
    "build:plugin:js": "vite build --config vite.plugin.config.ts",
    "build:plugin:types": "tsc -p tsconfig.plugin.json && rollup -c rollup.dts.config.mjs",
    "clean:temp": "rm -rf ./temp",
    "link": "npm link && npm link vue-track-plush"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChongYu-Yease/vue-track-plush"
  },
  "keywords": [
    "vue-track",
    "vue-track-plush",
    "vue",
    "track"
  ],
  "author": "xuchongyu",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.4",
    "less": "^4.1.3",
    "npm-run-all2": "^9.0.1",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue": "^2.7.16"
  },
  "dependencies": {
    "intersection-observer": "^0.11.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
