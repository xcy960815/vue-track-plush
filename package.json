{
  "name": "vue-track-plush",
  "version": "3.0.1",
  "description": "基于 vue 自定义指令的埋点统计插件",
  "main": "dist/vue-track-plush.umd.js",
  "module": "dist/vue-track-plush.esm.js",
  "types": "types/vue-track-plush.d.ts",
  "homepage": "https://xcy960815.github.io/vue-track-plush/",
  "private": false,
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "dev:plugin": "vite build --config vite.plugin.config.ts --watch",
    "build": "run-s clean:temp build:plugin:js build:plugin:types clean:temp",
    "build:plugin:js": "vite build --config vite.plugin.config.ts",
    "build:plugin:types": "tsc -p tsconfig.plugin.json && rollup -c rollup.dts.config.mjs",
    "clean:temp": "rm -rf ./temp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:prepare-demo": "rm -rf docs/public/demo && vite build --base ./ --outDir docs/public/demo",
    "docs:dev": "pnpm run docs:prepare-demo && pnpm --dir docs run dev",
    "docs:build": "pnpm run docs:prepare-demo && pnpm --dir docs run build",
    "docs:preview": "pnpm --dir docs run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcy960815/vue-track-plush.git"
  },
  "keywords": [
    "vue-track",
    "vue-track-plush",
    "vue",
    "track"
  ],
  "author": {
    "name": "xuchongyu",
    "email": "xuchongyu668@gmail.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "less": "^4.1.3",
    "npm-run-all2": "^9.0.1",
    "prettier": "^3.9.6",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.2.4",
    "vue": "^2.7.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^3.6.5"
  },
  "dependencies": {
    "intersection-observer": "^0.11.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
